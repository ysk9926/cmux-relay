{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relay report",
  "type": "object",
  "required": [
    "taskId",
    "dispatchId",
    "status",
    "summary",
    "stage",
    "confidence"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "dispatchId": {
      "type": "string",
      "description": "이번 지시의 dispatchId. 파일명 report-<dispatchId>.json 과 같아야 한다"
    },
    "status": {
      "enum": [
        "done",
        "needs_input",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "what"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "unmeasured": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "plan",
        "work",
        "review",
        "verify"
      ]
    },
    "confidence": {
      "enum": [
        "not_run",
        "reported_done",
        "verified"
      ],
      "description": "verified requires relay-owned receipts for explicitly approved, actually executed successful verification commands. Child assertions are insufficient."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "const": "verified"
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "done"
          },
          "stage": {
            "const": "verify"
          },
          "verification": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "pass"
                }
              }
            }
          }
        },
        "required": [
          "verification"
        ]
      }
    }
  ]
}
